{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 2
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "tick",
          "arm",
          "activation",
          "suction"
        ],
        "properties": {
          "tick": {
            "type": "integer",
            "minimum": 0
          },
          "arm": {
            "type": "integer",
            "minimum": 0,
            "maximum": 7
          },
          "activation": {
            "type": "array",
            "minItems": 7,
            "maxItems": 7,
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "suction": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "core_build_id": {
      "type": "string"
    },
    "scene_sha256": {
      "type": "string"
    },
    "profile_sha256": {
      "type": "string"
    },
    "numeric_backend": {
      "type": "string"
    },
    "cpu_arch": {
      "type": "string"
    },
    "initial_state": {
      "type": "string"
    },
    "seed": {
      "type": "integer",
      "minimum": 0
    },
    "fixed_dt": {
      "const": 0.008333333333333333
    },
    "snapshot_version": {
      "const": 3
    },
    "ticks": {
      "type": "integer",
      "minimum": 1,
      "maximum": 72000
    },
    "checksums": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "tick": {
            "type": "integer",
            "minimum": 1
          },
          "hash": {
            "type": "string",
            "pattern": "^[0-9]+$"
          }
        },
        "required": [
          "tick",
          "hash"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "events",
    "core_build_id",
    "scene_sha256",
    "profile_sha256",
    "numeric_backend",
    "cpu_arch",
    "initial_state",
    "seed",
    "fixed_dt",
    "snapshot_version",
    "ticks",
    "checksums"
  ],
  "additionalProperties": false
}
